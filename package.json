{
  "name": "@quidra-lang/playground",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "The official Quidra Playground: the Quidra compiler frontend, running in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quidra-lang/playground.git"
  },
  "scripts": {
    "core:build": "node scripts/prepare-core.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run version:check && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
